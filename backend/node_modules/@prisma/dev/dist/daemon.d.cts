type DaemonServer = Omit<ReadonlyServer, "experimental"> & {
    experimental?: {
        queryInsights?: ExperimentalQueryInsightsMetadata;
        streams?: ExperimentalStreams;
    };
};
interface DaemonMessageStarted {
    type: "started";
    server: DaemonServer;
}
/**
 * Machine-readable reason a daemon failed to start.
 *
 * Errors cross the IPC boundary as plain strings, so the parent process cannot
 * rely on `instanceof`. This code is the structured substitute.
 */
type DaemonErrorCode = "server_already_running" | "unknown";
interface DaemonMessageError {
    type: "error";
    code: DaemonErrorCode;
    error: string;
}
type DaemonMessage = DaemonMessageStarted | DaemonMessageError;

export type { DaemonErrorCode, DaemonMessage, DaemonMessageError, DaemonMessageStarted };
